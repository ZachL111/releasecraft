{
  "repo": "releasecraft",
  "language": "Ruby",
  "category": "Automation",
  "goal": "Classify changelog fragments into deterministic release sections.",
  "review_model": {
    "terms": [
      "dry-run spread",
      "rename risk",
      "operator cost",
      "idempotence"
    ],
    "lanes": [
